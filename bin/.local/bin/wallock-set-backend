#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"

# Pick random image
FILE=$1

if [ -z "$FILE" ]; then
  notify-send \
    -a "Wallpaper" \
    -i info \
    "Wallpaper" \
    "No images found in $WALLPAPER_DIR"
  exit 1
fi

# hyprlock can only render a static image, so resolve a still frame (a sibling
# poster or an extracted first frame) for animated wallpapers.
POSTER="$(wallpaper-poster "$FILE")"

# copy wallpaper to background for lock screen
cp "$POSTER" $XDG_CONFIG_HOME/background

notify-send \
  -a "Wallpaper" \
  -i info \
  "Wallpaper" \
  "Lock Screen Wallpaper changed to '$(basename "$FILE")'"
