#!/usr/bin/env bash
set -euo pipefail

dir="$XDG_CONFIG_HOME/rofi/launchers/type-1/"
theme='style-2'
WAYBAR_DIR="$XDG_CONFIG_HOME/waybar/custom styles"
SCRIPTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

IFS=$'\n'
cd "$WAYBAR_DIR"

chosen=$(
	for a in *.css; do
		echo -en "$a\0icon\x1f$a\n"
	done |
		rofi -dmenu -p "Select Waybar Styles" -theme "${dir}/${theme}.rasi"
)

if [ -n "$chosen" ]; then
	# call waybar-set.sh with the chosen filename (including extension)
	waybar-set "$WAYBAR_DIR/$chosen"
fi
