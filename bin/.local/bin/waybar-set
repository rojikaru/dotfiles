#!/usr/bin/env bash
# Generates ~/.config/waybar/style.css that imports the matugen + wallust
# colors followed by the chosen style. Color imports use absolute paths so
# they resolve no matter where the chosen style file lives.

set -euo pipefail

WAYBAR_DIR="$XDG_CONFIG_HOME/waybar"

FILE=$1
if [ -z "$FILE" ]; then
	notify-send \
		-a "Waybar" \
		-i error \
		"Waybar" \
		"No style file given"
	exit 1
fi

# Resolve the chosen style to an absolute path (accept a bare name or a path)
case "$FILE" in
/*) STYLE="$FILE" ;;
*) STYLE="$WAYBAR_DIR/custom styles/$FILE" ;;
esac

if [ ! -f "$STYLE" ]; then
	notify-send \
		-a "Waybar" \
		-i error \
		"Waybar" \
		"Style not found: $STYLE"
	exit 1
fi

# Replace style.css with a fresh regular file. Removing it first drops any
# existing symlink so we don't accidentally write through it into a style file.
rm -f "$WAYBAR_DIR/style.css"

echo "$WAYBAR_DIR/style.css"
cat >"$WAYBAR_DIR/style.css" <<EOF
/* This file is generated by ~/.local/bin/waybar-set */

@import url('$WAYBAR_DIR/colors.css');        /* matugen colors */
@import url('$WAYBAR_DIR/colors-waybar.css'); /* wallust colors */
@import url('$STYLE');                         /* chosen style   */
EOF

notify-send \
	-a "Waybar" \
	-i info \
	"Waybar" \
	"Style set to $(basename "$STYLE")"
