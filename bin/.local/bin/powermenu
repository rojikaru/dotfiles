#!/usr/bin/env bash
## Author  : Aditya Shakya (adi1090x)
## Github  : @adi1090x
#
## Applets : Power Menu

set -euo pipefail

# Current Theme
type="$XDG_CONFIG_HOME/rofi/applets/type-3"
style='style-2.rasi'
theme="$type/$style"

# Theme Elements
prompt="$(cat /etc/hostname)"
mesg="Uptime : $(uptime -p | sed -e 's/up //g')"

if [[ ("$theme" == *'type-1'*) || ("$theme" == *'type-3'*) || ("$theme" == *'type-5'*) ]]; then
	list_col='1'
	list_row='7'
elif [[ ("$theme" == *'type-2'*) || ("$theme" == *'type-4'*) ]]; then
	list_col='7'
	list_row='1'
fi

# Options
layout=$(cat ${theme} | grep 'USE_ICON' | cut -d'=' -f2)
if [[ "$layout" == 'NO' ]]; then
	option_1="󰌾 Lock"
	option_2="󰌵 Black screen"
	option_3="󰍃 Logout"
	option_4="󰒲 Suspend"
	option_5="󱍸 Hibernate"
	option_6="󰑓 Reboot"
	option_7="󰐥 Shutdown"
	yes='󰄬 Yes'
	no='󰅖 No'
else
	option_1="󰌾"
	option_2="󰌵"
	option_3="󰍃"
	option_4="󰒲"
	option_5="󱍸"
	option_6="󰑓"
	option_7="󰐥"
	yes='󰄬'
	no='󰅖'
fi

# Rofi CMD
rofi_cmd() {
	rofi -theme-str "listview {columns: $list_col; lines: $list_row;}" \
		-theme-str 'textbox-prompt-colon {str: "";}' \
		-dmenu \
		-p "$prompt" \
		-mesg "$mesg" \
		-markup-rows \
		-theme ${theme}
}

# Pass variables to rofi dmenu
run_rofi() {
	echo -e "$option_1\n$option_2\n$option_3\n$option_4\n$option_5\n$option_6\n$option_7" | rofi_cmd
}

# Confirmation CMD
confirm_cmd() {
	rofi -theme-str 'window {location: center; anchor: center; fullscreen: false; width: 350px;}' \
		-theme-str 'mainbox {orientation: vertical; children: [ "message", "listview" ];}' \
		-theme-str 'listview {columns: 2; lines: 1;}' \
		-theme-str 'element-text {horizontal-align: 0.5;}' \
		-theme-str 'textbox {horizontal-align: 0.5;}' \
		-dmenu \
		-p 'Confirmation' \
		-mesg 'Are you Sure?' \
		-theme ${theme}
}

# Confirm and execute
confirm_run() {
	selected="$(echo -e "$yes\n$no" | confirm_cmd)"
	if [[ "$selected" == "$yes" ]]; then
		eval "$1"
	else
		exit
	fi
}

# Actions
chosen="$(run_rofi)"
case ${chosen} in
$option_1)
	hyprlock
	;;
$option_2)
	brightnessctl set 0
	;;
$option_3)
	confirm_run 'hyprshutdown --post-cmd "uwsm stop"'
	;;
$option_4)
	confirm_run 'systemctl suspend-then-hibernate'
	;;
$option_5)
	confirm_run 'systemctl hibernate'
	;;
$option_6)
	confirm_run 'hyprshutdown --post-cmd "systemctl reboot"'
	;;
$option_7)
	confirm_run 'hyprshutdown --post-cmd "systemctl poweroff"'
	;;
esac
