#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
LAST_FILE="$HOME/.cache/last_wallpaper"  # remembers last wallpaper
CACHE="$HOME/.cache/wallpapers_list.txt" # cached list of wallpapers
SDDM_WALLPAPER="/usr/share/wallpapers/Next/contents/images/5120x2880.png"
IS_CHANGING_SDDM_BG=0

# === Build cached file list (symlink-safe) ===
if [ ! -f "$CACHE" ] || [ "$(find -L "$WALLPAPER_DIR" -type f | wc -l)" -ne "$(wc -l <"$CACHE")" ]; then
	echo "Building wallpaper cache..."
	find -L "$WALLPAPER_DIR" -type f \
		\( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.gif" \) \
		>"$CACHE"
fi

# === Load wallpaper list ===
mapfile -t FILES <"$CACHE"

if [ ${#FILES[@]} -eq 0 ]; then
	notify-send \
		-a "Wallpaper" \
		-i error \
		"Wallpaper" \
		"No images found in $WALLPAPER_DIR"
	exit 1
fi

# === Load last wallpaper ===
LAST=""
[ -f "$LAST_FILE" ] && LAST=$(<"$LAST_FILE")

# === Pick a random wallpaper, not same as last ===
while :; do
	FILE="${FILES[RANDOM % ${#FILES[@]}]}"
	[ "$FILE" != "$LAST" ] && break
done

# === Save current wallpaper as last ===
echo "$FILE" >"$LAST_FILE"

awww img "$FILE" \
	--transition-type any \
	--transition-duration 1.3 \
	--transition-fps 60 \
	--transition-step 50

# === Apply wallpaper and generate theme ===
wal --saturate 0.5 -a 0.8 -i "$FILE" -s
wallust run "$FILE"

matugen --source-color-index 0 image "$FILE"

cp "$FILE" ~/.config/background

# Copy to sddm theme
sddm_extensions=("png" "jpg" "jpeg" "webp" "gif")
if [ "$IS_CHANGING_SDDM_BG" -eq 1 ]; then
	if [[ " ${sddm_extensions[*]} " == *" ${FILE##*.} "* ]]; then
		pkexec cp "$FILE" "$SDDM_WALLPAPER"
		notify-send \
			-a "Wallpaper" \
			-i info \
			"Wallpaper" \
			"Image has been set to sddm"
	else
		pkexec magick "$FILE" "$SDDM_WALLPAPER"
		notify-send \
			-a "Wallpaper" \
			-i info \
			"Wallpaper" \
			"Image has been generated and set to sddm"
	fi
fi

swaync-client -rs &

pywal-cava

notify-send \
	-a "Wallpaper" \
	-i info \
	"Wallpaper" \
	"Successfully changed to '$(basename "$FILE")'"
