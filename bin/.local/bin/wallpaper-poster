#!/usr/bin/env bash
# wallpaper-poster: resolve a STATIC image for any wallpaper file and print its path.
#
# Static images (png/jpg/jpeg/webp/bmp) are printed unchanged.
# Animated files (gif/mp4/webm/mov/mkv/m4v/avi) resolve to, in order:
#   1. a sibling poster with the same basename (.png/.jpg/.jpeg/.webp), if present
#   2. an extracted first frame cached under ~/.cache/wallpaper-posters/
#
# This exists because neither hyprlock nor pywal/wallust/matugen can read video,
# so they must be fed a still frame instead.

set -euo pipefail

FILE="${1:?usage: wallpaper-poster <file>}"
ext="${FILE##*.}"
ext="${ext,,}"

case "$ext" in
png | jpg | jpeg | webp | bmp)
	echo "$FILE"
	exit 0
	;;
esac

# Animated: prefer a hand-made sibling poster (the convention already used in the
# wallpapers dir, e.g. foo.mp4 + foo.png).
base="${FILE%.*}"
for e in png jpg jpeg webp; do
	if [ -f "$base.$e" ]; then
		echo "$base.$e"
		exit 0
	fi
done

# Fall back to extracting the first frame, cached and invalidated by mtime.
cache="$HOME/.cache/wallpaper-posters"
mkdir -p "$cache"
out="$cache/$(basename "$base").png"

if [ ! -f "$out" ] || [ "$FILE" -nt "$out" ]; then
	case "$ext" in
	gif)
		magick "${FILE}[0]" "$out"
		;;
	*)
		ffmpeg -y -loglevel error -i "$FILE" -frames:v 1 "$out" </dev/null
		;;
	esac
fi

echo "$out"
