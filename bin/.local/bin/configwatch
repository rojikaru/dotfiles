#!/usr/bin/env bash
# Reload Hyprland, SwayNC and Waybar when the config changes

set -euo pipefail

DEBOUNCE_SECS=1

debounce() {
	local debounce="${1:-2}"
	shift
	local fn="$*"
	local pid=""

	while read -r _; do
		# Kill any pending timer
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			kill "$pid" 2>/dev/null
		fi
		# Start a new timer
		(sleep "$debounce" && eval "$fn") &
		pid=$!
	done
}

watch() {
	local dir="$1"
	local cmd="$2"
	local exclude=${3:-}

	local paths=$(
		find -L "$dir" -print0 2>/dev/null |
			xargs -0 realpath -ze 2>/dev/null |
			tr '\0' '\n' |
			sort -u
	)

	[[ -z "$paths" ]] && return

	local inotify_args=(-mr --event modify,create,delete,move,attrib)
	[[ -n "$exclude" ]] && inotify_args+=(--exclude "$exclude")

	echo "$paths" | xargs --delimiter='\n' inotifywait "${inotify_args[@]}" |
		debounce $DEBOUNCE_SECS "$2"
}

watch "$XDG_CONFIG_HOME/hypr" "hyprctl reload" &
watch "$XDG_CONFIG_HOME/swaync" "swaync-client -R -rs" &
watch "$XDG_CONFIG_HOME/waybar" "pkill waybar; sleep 0.1; uwsm app -- waybar &" "style.css" &
