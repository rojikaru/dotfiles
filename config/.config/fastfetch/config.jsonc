// Inspired by Catnap
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "color": {
      "1": "38;5;14"
    },
    "padding": {
      "top": 4,
      "left": 4,
      "right": 4
    },
    "source": "$XDG_CONFIG_HOME/fastfetch/logos/miniarch.txt"
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom"
    },
    {
      "key": "│ {#31} user    {#keys}│",
      "type": "title",
      "format": "{user-name}"
    },
    {
      "key": "│ {#32}󰇅 host    {#keys}│",
      "type": "title",
      "format": "{host-name}"
    },
    {
      "key": "│ {#33}󰅐 uptime  {#keys}│",
      "type": "uptime"
    },
    {
      "key": "│ {#34}󰅐 OS age  {#keys}│",
      "type": "command",
      "text": "os-age"
    },
    {
      "key": "│ {#35}{icon} distro  {#keys}│",
      "type": "os"
    },
    {
      "key": "│ {#36} kernel  {#keys}│",
      "type": "kernel"
    },
    {
      "key": "│ {#37}󰇄 de      {#keys}│",
      "type": "de"
    },
    {
      "key": "│ {#37} wm      {#keys}│",
      "type": "wm"
    },
    {
      "key": "│ {#34} term    {#keys}│",
      "type": "terminal"
    },
    {
      "key": "│ {#32} shell   {#keys}│",
      "type": "shell"
    },
    {
      "key": "│ {#33}󰍛 cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true
    },
    {
      "key": "│ {#35} memory  {#keys}│",
      "type": "memory"
    },
    {
      "key": "│ {#34}󰉉 disk    {#keys}│",
      "type": "disk"
    },
    {
      "key": "│ {#39} gpu     {#keys}│",
      "type": "gpu"
    },
    {
      "key": "├───────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#36} colors  {#keys}│",
      "type": "colors",
      "symbol": "circle"
    },
    {
      "key": "╰───────────╯",
      "type": "custom"
    }
  ]
}
